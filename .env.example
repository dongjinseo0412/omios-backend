# Local development example values only. Do not commit real secrets.
OMIOS_DB_USER=root
OMIOS_DB_PASSWORD=your_mysql_password
OMIOS_DB_HOST=127.0.0.1
OMIOS_DB_PORT=3306
OMIOS_DB_NAME=omios

# Comma-separated origins. Railway production should use the deployed frontend URL.
OMIOS_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
OMIOS_CORS_ALLOW_CREDENTIALS=false
