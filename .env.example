# Copy to .env for local development. Do not commit real secrets.
OMIOS_DB_USER=root
OMIOS_DB_PASSWORD=change-me
OMIOS_DB_HOST=127.0.0.1
OMIOS_DB_PORT=3306
OMIOS_DB_NAME=omios

# React dev defaults are allowed automatically when unset.
# For production, set this to the deployed frontend origin(s), comma-separated.
OMIOS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
OMIOS_CORS_ALLOW_CREDENTIALS=false

# Common deployment platforms provide PORT automatically.
PORT=8000
ENV=development
